<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 and lower (android:fullBackupContent).
  Keep in sync with data_extraction_rules.xml, which applies on Android 12+.

  - survey_database.db: the participant's history (survey answers, location
    tracks). Always excluded here; HistoryBackupAgent adds it back when a
    backup runs if the participant turned "Include my data in phone backups"
    on in Settings (off by default).
  - open_background_locator_buffer.db: the location plugin's buffer, a
    short-lived queue of raw location history. Restoring it on another device
    would inject the old device's fixes.
  - unpushedLocationsStorage.db: legacy; nothing opens it any more.
-->
<full-backup-content>
    <exclude domain="database" path="survey_database.db" />
    <exclude domain="database" path="survey_database.db-journal" />
    <exclude domain="database" path="survey_database.db-wal" />
    <exclude domain="database" path="survey_database.db-shm" />
    <exclude domain="database" path="open_background_locator_buffer.db" />
    <exclude domain="database" path="open_background_locator_buffer.db-journal" />
    <exclude domain="database" path="open_background_locator_buffer.db-wal" />
    <exclude domain="database" path="open_background_locator_buffer.db-shm" />
    <exclude domain="database" path="unpushedLocationsStorage.db" />
    <exclude domain="database" path="unpushedLocationsStorage.db-journal" />
    <exclude domain="database" path="unpushedLocationsStorage.db-wal" />
    <exclude domain="database" path="unpushedLocationsStorage.db-shm" />
</full-backup-content>
